# Base de datos. SQLite por defecto; para que la caché sobreviva reinicios en Render
# usa una base PostgreSQL: DATABASE_URL=postgresql://usuario:clave@host/db
DATABASE_URL=sqlite:///./data/antiplagio.db

# Búsqueda: varios buscadores web consultados por separado (no requieren clave)
SEARCH_ENGINE=multi
SEARCH_WEB_ENGINES=google,yahoo,yandex,duckduckgo,bing,brave,mojeek,startpage
ENGINES_PER_QUERY=2           # buscadores con resultados exigidos por consulta
# Bases académicas y enciclopédicas (APIs abiertas)
ENABLE_OPENALEX=true
ENABLE_CROSSREF=true
ENABLE_WIKIPEDIA=true
MAX_API_QUERIES=15
# Repositorio interno: compara con documentos analizados antes (copia entre estudiantes).
# Ojo: una versión editada del mismo trabajo subida de nuevo aparecerá como coincidencia.
ENABLE_REPOSITORY=false
# Opcionales con clave (mejoran la cobertura en servidores donde los buscadores bloquean)
BRAVE_API_KEY=
OPENALEX_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Motor de plagio (valores por defecto recomendados)
MAX_QUERIES_PASS1=40          # consultas de la pasada 1 (búsqueda amplia)
MAX_QUERIES_PASS3=20          # consultas de la pasada 3 (frases exactas)
MAX_SOURCES_TO_CHECK=60       # páginas que se descargan y comparan
MIN_MATCH_WORDS=8             # tramo mínimo considerado copia
PARAPHRASE_THRESHOLD=0.72     # 0-1, más alto = paráfrasis más estricta
SOURCE_FLAG_COVERAGE=1.0      # % del texto para marcar una fuente "con plagio"
EXCLUDE_BIBLIOGRAPHY=true     # no contar la sección de referencias
EXCLUDE_QUOTES=true           # las citas entre comillas no suman a la similitud global
CACHE_TTL_DAYS=30             # días que se reutilizan búsquedas (consistencia)
