# Base de datos. SQLite por defecto; para que la caché sobreviva reinicios en Render
# usa una base PostgreSQL: DATABASE_URL=postgresql://usuario:clave@host/db
DATABASE_URL=sqlite:///./data/antiplagio.db

# Buscador: duckduckgo (por defecto, sin clave) o google (requiere las dos claves)
SEARCH_ENGINE=duckduckgo
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Motor de plagio (valores por defecto recomendados)
MAX_QUERIES_PASS1=40          # consultas de la pasada 1 (búsqueda amplia)
MAX_QUERIES_PASS3=20          # consultas de la pasada 3 (frases exactas)
MAX_SOURCES_TO_CHECK=60       # páginas que se descargan y comparan
MIN_MATCH_WORDS=8             # tramo mínimo considerado copia
PARAPHRASE_THRESHOLD=0.72     # 0-1, más alto = paráfrasis más estricta
SOURCE_FLAG_COVERAGE=1.0      # % del texto para marcar una fuente "con plagio"
EXCLUDE_BIBLIOGRAPHY=true     # no contar la sección de referencias
CACHE_TTL_DAYS=30             # días que se reutilizan búsquedas (consistencia)
